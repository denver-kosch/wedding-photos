generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  UPLOADING @map("uploading")
  COMPLETED @map("completed")
  PARTIAL   @map("partial")
  FAILED    @map("failed")
}

enum AssetStatus {
  PENDING @map("pending")
  PROCESSING @map("processing")
  COMPLETED @map("completed")
  FAILED @map("failed")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SubmissionAsset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId     String      @map("submission_id") @db.Uuid
  immichAssetId    String?     @map("immich_asset_id") @db.Uuid
  originalFilename String      @map("original_filename")
  mimeType         String?     @map("mime_type") @db.VarChar(100)
  fileSizeBytes    BigInt?     @map("file_size_bytes")
  uploadOrder      Int         @default(0) @map("upload_order")
  status           AssetStatus @default(PENDING)
  errorMessage     String?     @map("error_message")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedAt       DateTime?   @map("uploaded_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status])
  @@index([submissionId])
  @@index([immichAssetId])
  @@map("submission_assets")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Submission {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submittedBy          String            @map("submitted_by") @db.VarChar(100)
  message              String?           @db.VarChar(500)
  uploadToken          String            @unique(map: "submissions_upload_token_key") @default(dbgenerated("gen_random_uuid()")) @map("upload_token") @db.Uuid
  status               SubmissionStatus  @default(UPLOADING)
  expectedAssetCount   Int?              @map("expected_asset_count")
  successfulAssetCount Int               @default(0) @map("successful_asset_count")
  failedAssetCount     Int               @default(0) @map("failed_asset_count")
  ipAddress            String?           @map("ip_address") @db.Inet
  userAgent            String?           @map("user_agent")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)

  assets SubmissionAsset[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("submissions")
}
